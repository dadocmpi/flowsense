# ============================================
# FLOWSENSE — ENVIRONMENT VARIABLES
# ============================================
# Copy to .env.local for local use, and set the same names in the Vercel
# project (Settings → Environment Variables) for the deployment.
#
# EVERY variable here is read ONLY by the serverless functions under api/.
# None of them is exposed to the browser bundle — verify with:
#   npm run build && grep -c "apikey" dist/assets/*.js   # must be 0
#
# --- Twelve Data (Gold GC) — REQUIRED for Gold -----------------------------
# Server-side credential. Until this is set, Gold shows a "no data source
# configured" state and no numbers at all.
TWELVE_DATA_API_KEY=

# --- Alpaca (S&P 500 ES, Dow YM, Nasdaq NQ) — REQUIRED for the index assets --
# Server-side credentials only. Alpaca authenticates with the two headers
# APCA-API-KEY-ID and APCA-API-SECRET-KEY, so both are needed. They are read ONLY
# under api/ and must never be prefixed NEXT_PUBLIC_ or exposed to the bundle.
# Until they are set, the index assets show "no data source configured".
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Optional --------------------------------------------------------------

# --- Order flow (the RIGHT compass) — one real venue, chosen PER ASSET ------
# The order flow compass reads a REAL venue. Every shipped asset reads Alpaca,
# the same provider that serves the index assets' candles, so its order flow uses
# the ALPACA_API_KEY / ALPACA_API_SECRET set above and needs nothing extra:
#
#   GC  Gold     -> Alpaca   (GLD tape + IEX top of book; GLD is a real gold ETF)
#   ES  S&P 500  -> Alpaca   (SPY tape + IEX top of book)
#   YM  Dow      -> Alpaca   (DIA)
#   NQ  Nasdaq   -> Alpaca   (QQQ)
#
# The symbol read is an ETF PROXY for the instrument, and the reading's source
# label says so. Alpaca publishes the tape and the IEX best bid/ask only (a
# one-level "top of book"), never a depth ladder. With the Alpaca keys set, every
# asset shows real order flow out of the box.
#
# ORDERFLOW_PROVIDER overrides the venue for the WHOLE deployment (set it to
# `none` to switch order flow off everywhere). Leave it unset to use Alpaca.
# Binance is no longer a venue; a leftover `ORDERFLOW_PROVIDER=binance` resolves
# to Alpaca rather than leaving the compass empty.
# ORDERFLOW_PROVIDER=

# Override the venue for ONE asset. Values: alpaca | none.
# ORDERFLOW_PROVIDER_GC=alpaca
# ORDERFLOW_PROVIDER_ES=alpaca
# ORDERFLOW_PROVIDER_YM=alpaca
# ORDERFLOW_PROVIDER_NQ=alpaca

# Override the Alpaca symbol an instrument's ORDER FLOW is read from. Defaults
# are the ETF proxies above (GC -> GLD, ES -> SPY, YM -> DIA, NQ -> QQQ). There
# is no candidate walk: an instrument with no configured market shows "no market"
# rather than reading a different symbol.
# ORDERFLOW_SYMBOL_GC=GLD
# ORDERFLOW_SYMBOL_ES=SPY

# Which provider serves each asset. Defaults: GC -> twelvedata (XAU/USD),
# ES -> alpaca (SPY), YM -> alpaca (DIA), NQ -> alpaca (QQQ). Moving an asset to
# the other provider is a config change and nothing else.
# ASSET_PROVIDER_GC=twelvedata
# ASSET_PROVIDER_ES=alpaca
# ASSET_PROVIDER_YM=alpaca
# ASSET_PROVIDER_NQ=alpaca

# Pin an asset to the ONE symbol its provider is asked for. There is no runtime
# candidate walk: a failing symbol returns an error for that asset rather than
# spending another call on a fallback.
# ASSET_SYMBOL_GC=XAU/USD
# ASSET_SYMBOL_ES=SPY
# ASSET_SYMBOL_YM=DIA
# ASSET_SYMBOL_NQ=QQQ

# Alpaca request ceiling per minute. Alpaca's free plan allows 200. Alpaca meters
# REQUESTS, not credits, so one multi-symbol bars call counts once however many
# symbols it carries.
# ALPACA_REQUESTS_PER_MINUTE=200

# Attempt the vendor price WebSocket for futures. Default: true.
# When false (or when the socket cannot be reached) the price is polled instead,
# and the UI shows "Delayed (polling)" rather than "Live".
# TWELVE_DATA_WS=true

# Legacy Twelve Data symbol pin. Prefer ASSET_SYMBOL_<ID> above.
# TWELVE_DATA_SYMBOL_GC=XAU/USD

# Per-minute credit ceiling the meter enforces for Twelve Data. Default: 8.
# The meter adopts the vendor's own api-credits-used/-left headers when present,
# so this only matters before the first response of a minute.
# TWELVE_DATA_CREDITS_PER_MINUTE=8

# How the continuous series is described. The roll itself is handled upstream by
# the vendor, because rolling correctly needs the exchange calendar and open
# interest, which candles alone cannot reconstruct.
# FUTURES_ROLL_METHOD=frontMonth
# FUTURES_ROLL_ADJUSTMENT=none

# Legacy: setting TWELVE_DATA_API_KEY alone selects Twelve Data. Set this only
# when adding a second vendor.
# FUTURES_PROVIDER=twelvedata
# FUTURES_API_KEY=
