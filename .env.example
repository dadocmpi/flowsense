# ============================================
# FLOWSENSE — ENVIRONMENT VARIABLES
# ============================================
# Copy to .env.local for local use, and set the same names in the Vercel
# project (Settings → Environment Variables) for the deployment.
#
# EVERY variable here is read ONLY by the serverless functions under api/.
# None of them is exposed to the browser bundle — verify with:
#   npm run build && grep -c "apikey" dist/assets/*.js   # must be 0
#
# --- Twelve Data (Gold GC, S&P 500 ES, Dow YM, Nasdaq NQ) — REQUIRED ---------
# Server-side credential. Until this is set, the instruments show a "no data
# source configured" state and no numbers at all.
TWELVE_DATA_API_KEY=

# --- Optional --------------------------------------------------------------

# Attempt the vendor price WebSocket for futures. Default: true.
# When false (or when the socket cannot be reached) the price is polled instead,
# and the UI shows "Delayed (polling)" rather than "Live".
# TWELVE_DATA_WS=true

# Pin an instrument to the ONE symbol it reads. There is no runtime candidate
# walk: the app requests exactly this symbol and returns an error for the asset
# if it fails, rather than spending another credit on a fallback. The defaults
# live in src/config/symbols.ts and are spot / ETF proxies, because Twelve Data
# does not entitle the continuous-futures contracts (GC1!, ES1!, YM1!, NQ1!) on
# every plan. Use `npm run check:symbols` (out of band) to find which symbol your
# plan entitles.
# SYMBOL_GOLD=XAU/USD
# SYMBOL_SP500=SPY
# SYMBOL_DOW=DIA
# SYMBOL_NASDAQ=QQQ

# Per-minute credit ceiling the meter enforces. Default: 8 (Twelve Data Basic).
# The meter adopts the vendor's own api-credits-used/-left headers when present,
# so this only matters before the first response of a minute.
# TWELVE_DATA_CREDITS_PER_MINUTE=8

# Daily credit ceiling. Default: 800. The meter warns once at 80% and stops
# vendor calls at 100%. Set 0 to disable the daily cap.
# TWELVE_DATA_DAILY_CAP=800

# How often the Summary price and the M1 reading of the selected asset are
# refreshed, in milliseconds. Default: 60000. This is a REST poll; no WebSocket
# is used (that needs an always-on server and a Pro plan).
# LIVE_POLL_INTERVAL_MS=60000

# --- News / economic calendar (optional) -----------------------------------
# The "Today" panel's source. NEWS_PROVIDER selects the adapter and NEWS_API_KEY
# is its key; BOTH are read server-side only (api/_lib/news.ts), never in the
# browser. Unset shows "No news source configured". The vendor call is cached
# server-side for ~5 minutes and costs NO Twelve Data credits.
# NEWS_PROVIDER=fmp
# NEWS_API_KEY=

# How the continuous series is described. The roll itself is handled upstream by
# the vendor, because rolling correctly needs the exchange calendar and open
# interest, which candles alone cannot reconstruct.
# FUTURES_ROLL_METHOD=frontMonth
# FUTURES_ROLL_ADJUSTMENT=none

# Legacy: setting TWELVE_DATA_API_KEY alone selects Twelve Data. Set this only
# when adding a second vendor.
# FUTURES_PROVIDER=twelvedata
# FUTURES_API_KEY=
