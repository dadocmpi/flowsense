# ============================================
# FLOWSENSE — ENVIRONMENT VARIABLES
# ============================================
# Copy to .env.local for local use, and set the same names in the Vercel
# project (Settings → Environment Variables) for the deployment.
#
# EVERY variable here is read ONLY by the serverless functions under api/.
# None of them is exposed to the browser bundle — verify with:
#   npm run build && grep -c "apikey" dist/assets/*.js   # must be 0
#
# --- Twelve Data (Gold, S&P 500, Dow, Nasdaq) — REQUIRED -------------------
# Server-side credential. Until this is set, the futures instruments show a
# "no data source configured" state and no numbers at all.
TWELVE_DATA_API_KEY=

# --- Optional --------------------------------------------------------------

# Attempt the vendor price WebSocket for futures. Default: true.
# When false (or when the socket cannot be reached) the price is polled instead,
# and the UI shows "Delayed (polling)" rather than "Live".
# TWELVE_DATA_WS=true

# Pin an asset to the ONE symbol it reads. There is no runtime candidate walk:
# the app requests exactly this symbol and returns an error for the asset if it
# fails, rather than spending another credit on a fallback.
#
# The DEFAULTS work on the Twelve Data FREE plan: they are spot / ETF proxies,
# not the continuous futures contracts (GC1!/ES1!/YM1!/NQ1!), which the free plan
# does not carry. A proxy is always labelled a proxy in the UI.
#
#   SYMBOL_GOLD    default XAU/USD  (spot gold)
#   SYMBOL_SP500   default SPY      (SPDR S&P 500 ETF)
#   SYMBOL_DOW     default DIA      (SPDR Dow Jones ETF)
#   SYMBOL_NASDAQ  default QQQ      (Invesco QQQ Trust, Nasdaq-100 ETF)
#
# On a plan that carries futures data, set the continuous contract instead, e.g.
# SYMBOL_GOLD=GC1! (a "!"-suffixed symbol is labelled a futures contract).
# Use `npm run check:symbols` (out of band) to find which symbol your plan
# entitles.
# SYMBOL_GOLD=XAU/USD
# SYMBOL_SP500=SPY
# SYMBOL_DOW=DIA
# SYMBOL_NASDAQ=QQQ

# Per-minute credit ceiling the meter enforces. Default: 8 (Twelve Data free
# plan). One full asset load is 7 credits — one per timeframe — so this must stay
# at 8 or above for a load to complete in a single minute. The meter adopts the
# vendor's own api-credits-used/-left headers when present, so this only matters
# before the first response of a minute.
# TWELVE_DATA_CREDITS_PER_MINUTE=8

# Legacy names, still honoured so an existing deployment keeps working:
#   TWELVE_DATA_SYMBOL_GC / _ES / _YM / _NQ  same as SYMBOL_* above
#   FUTURES_API_KEY                          same as TWELVE_DATA_API_KEY
#   FUTURES_PROVIDER                         setting the key alone selects Twelve Data
